// =====================================================================
//  Cenário experimental da AgentDSL: "Pega-Fujão"
//  Pegue todos os fujões (amarelos) sem perder as 5 vidas para os
//  guardas (vermelhos). ESPAÇO ataca os guardas que estiverem perto.
//
//  Percepções geradas pelo jogo: jogador_perto, tocando_jogador,
//  borda (pulso), recebeu_dano (pulso). Ações: ver README.
// =====================================================================

// ---------- Guarda: patrulha e persegue o jogador ---------------------
agente guarda sprite "guarda.png" em (300, 560) camada 2 {
    vivo.
    vida(3).
    patrulhando.
    raio_visao(210).

    +vivo <- velocidade(90, 0).
    +borda : patrulhando <- inverter.

    +jogador_perto : vivo
        <- -patrulhando; perseguir(jogador, 125); cor(1, 0.75, 0.75).
    -jogador_perto : vivo
        <- +patrulhando; velocidade(90, 0); cor(1, 1, 1).

    +tocando_jogador : vivo <- atacar(jogador, 1).

    // Cada golpe tira 1 de vida; no último o guarda sai de cena.
    +recebeu_dano : vida(V) & V > 1
        <- -+vida(V - 1); rotacionar(30); escalar(0.85);
           imprimir("ai! vida restante:", V - 1).
    +recebeu_dano : vida(1)
        <- -vida(1); -vivo; parar; sumir; pontuar(50).
}

// Herança: mesmos planos e crenças, outro lugar e mais rápido de olho.
agente guarda2 : guarda sprite "guarda.png" em (980, 140) camada 2 {
    raio_visao(260).
    +vivo <- velocidade(0, 110).
}

// ---------- Fujão: foge do jogador, é capturado ao ser tocado ---------
agente fujao sprite "fujao.png" em (1100, 600) camada 2 {
    vivo.
    fugitivo.
    raio_visao(190).

    +vivo <- velocidade(-70, -50).
    +borda : vivo & nao jogador_perto <- inverter.

    +jogador_perto : vivo <- fugir(jogador, 150).
    -jogador_perto : vivo <- velocidade(60, 60).

    +tocando_jogador : fugitivo
        <- -fugitivo; -vivo; parar; sumir; pontuar(10);
           imprimir("fui pego!").
}

agente fujao2 : fujao sprite "fujao.png" em (150, 120) camada 2 {
    +vivo <- velocidade(80, 40).
}

agente fujao3 : fujao sprite "fujao.png" em (640, 640) camada 2 {
    raio_visao(150).
}

// ---------- Estrela: decoração que reage à aproximação ----------------
agente estrela sprite "estrela.png" em (640, 200) camada 1 {
    brilhando.
    raio_visao(120).

    +brilhando <- girar(60).
    // Sobe de camada (passa a ser desenhada por cima do jogador) e cresce.
    +jogador_perto <- mudar_camada(5); escalar(1.6); girar(240).
    -jogador_perto <- mudar_camada(1); escalar(0.625); girar(60).
}
